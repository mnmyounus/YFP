<?xml version="1.0" encoding="utf-8"?>
<!--
    Flattened combination of ic_launcher_background + ic_launcher_foreground
    for devices below API 26 that don't understand <adaptive-icon>. Referenced
    by mipmap-anydpi-v21/ic_launcher.xml (default, all-density mipmap folder)
    as a vector drawable, which is a standard, supported technique and scales
    cleanly to every density without needing separate rasterized PNGs per
    bucket (no image rasterizer is available in this build environment to
    generate them, and a vector avoids that dependency entirely, at the
    same visual result once rendered on-device).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#0D1512" android:pathData="M0,0h108v108h-108z" />
    <path android:fillColor="#FFFFFF" android:pathData="M54,20 L78,29 V50 C78,66 68,79 54,84 C40,79 30,66 30,50 V29 Z" />
    <path android:fillColor="#2E7D6B" android:pathData="M54,26 L72,32.5 V50 C72,62.5 64.5,72.5 54,76.5 C43.5,72.5 36,62.5 36,50 V32.5 Z" />
