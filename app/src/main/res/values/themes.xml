<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.YFP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_primary_dark</item>
    </style>

    <!-- TV theme: no action bar, dark background matched to tv_background,
         Leanback-appropriate (large focus targets driven by the row styles
         below rather than by this theme's typography). -->
    <style name="Theme.YFP.Tv" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="colorPrimary">@color/tv_accent</item>
        <item name="colorAccent">@color/tv_accent</item>
    </style>

    <!-- A standard focusable D-pad row: flat, high-contrast focused state
         via selector background (see drawable/tv_row_background.xml),
         generously sized touch/focus target, no ripple (ripples are a touch
         affordance and read as visual noise on a TV with D-pad-only input). -->
    <style name="Widget.YFP.Tv.FocusableRow" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/tv_row_background</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Widget.YFP.Tv.PrimaryRow" parent="Widget.YFP.Tv.FocusableRow">
        <item name="android:background">@drawable/tv_primary_row_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
