    <!-- Pattern selection -->
    <string name="label_overwrite_pattern">Overwrite pattern</string>
    <string name="pattern_pseudo_random_label">Pseudo-Random</string>
    <string name="pattern_pseudo_random_description">Non-repeating data pattern. Slightly slower, thorough.</string>
    <string name="pattern_zero_fill_label">Zero-Fill</string>
    <string name="pattern_zero_fill_description">All-zero pattern. Fastest option.</string>

    <string name="disclaimer_not_forensic_grade">YFP overwrites free space to prevent common recovery tools from restoring deleted files. It does not make forensic-grade claims (e.g. DoD 5220.22-M) — on flash storage, wear-leveling means no consumer tool can guarantee every physical cell is touched.</string>

