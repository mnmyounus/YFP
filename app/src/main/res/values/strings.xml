    <string name="dialog_confirm_start_title">Start overwrite?</string>
    <string name="dialog_confirm_start_message">YFP will fill up to %1$d%% of free space on %2$s with dummy files, then delete them. This can take a while depending on storage speed and size. You can pause or cancel at any time.</string>
    <string name="dialog_confirm_delete_title">Delete dummy files?</string>
    <string name="dialog_confirm_delete_message">This will stop the current wipe (if running) and immediately delete all dummy files YFP has created, freeing the space back up.</string>

